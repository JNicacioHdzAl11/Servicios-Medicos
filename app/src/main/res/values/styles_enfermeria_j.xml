<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EnfermeriaJ" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_boton_primario</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/color_fondo_secundario</item>
    </style>
    <style name="SaludCampus.BotonEnlace" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/color_enlace</item><item name="iconTint">@color/color_enlace</item>
    </style>
    <style name="SaludCampus.BotonPrimario" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/color_boton_primario</item><item name="android:textColor">@color/color_boton_primario_texto</item><item name="cornerRadius">12dp</item>
    </style>
    <style name="SaludCampus.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/color_fondo</item><item name="boxStrokeColor">@color/selector_campo_borde</item>
    </style>
</resources>
