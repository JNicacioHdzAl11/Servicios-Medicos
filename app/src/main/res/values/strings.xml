    <!-- Términos del servicio -->
    <string name="terminos_titulo">Términos del servicio</string>
    <string name="terminos_subtitulo">Lineamientos del servicio médico universitario</string>
    <string name="terminos_version">Versión de referencia · Noviembre de 2026</string>
    <string name="terminos_seccion1_titulo">1. Acceso al servicio</string>
    <string name="terminos_seccion1_texto">La atención está dirigida a alumnos con matrícula y afiliación vigentes. Presenta tu credencial y comprobante al acudir.</string>
    <string name="terminos_seccion2_titulo">2. Citas y puntualidad</string>
    <string name="terminos_seccion2_texto">Agenda mediante el portal y llega 10 minutos antes. Si no puedes asistir, cancela o solicita la reprogramación con anticipación.</string>
    <string name="terminos_seccion3_titulo">3. Alcance de la atención</string>
    <string name="terminos_seccion3_texto">El servicio brinda valoración inicial, orientación preventiva y seguimiento. Cuando se requiera, el médico indicará la referencia a otra unidad.</string>
    <string name="terminos_seccion4_titulo">4. Trato y responsabilidad</string>
    <string name="terminos_seccion4_texto">Recibe un trato respetuoso y proporciona información veraz sobre tus antecedentes, alergias y medicamentos. Sigue las indicaciones del personal.</string>
    <string name="terminos_seccion5_titulo">5. Confidencialidad</string>
    <string name="terminos_seccion5_texto">Tu información clínica es confidencial. El acceso y la entrega del expediente requieren identificación y los procedimientos correspondientes.</string>
    <string name="terminos_seccion6_titulo">6. Situaciones de urgencia</string>
    <string name="terminos_seccion6_texto">En una emergencia, solicita apoyo inmediato al personal del campus o llama al 911. No esperes a una cita programada.</string>
    <string name="terminos_btn_descargar_pdf">Descargar términos en PDF</string>
    <string name="terminos_nota">Texto de ejemplo para el mockup; sujeto a revisión institucional.</string>

