<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Salud Campus UTHH: estilos de la navegación inferior (solo modo claro) -->
    <style name="SaludCampus.IndicadorNavegacion" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_fondo_azul_claro</item>
        <item name="shapeAppearance">@style/SaludCampus.FormaIndicador</item>
    </style>

    <style name="SaludCampus.FormaIndicador" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="SaludCampus.TextoNavegacion" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SaludCampus.TextoNavegacion.Activo">
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Pantallas del alumno: botones de opción (especialidad, horario, pestañas) -->
    <style name="SaludCampus.BotonOpcion" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/selector_opcion_texto</item>
        <item name="backgroundTint">@color/selector_opcion_fondo</item>
        <item name="strokeColor">@color/selector_opcion_borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Foto de perfil con esquinas redondeadas -->
    <style name="SaludCampus.FormaAvatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Etiquetas informativas (Preventiva, Gratuita…) -->
    <style name="SaludCampus.Etiqueta" parent="Widget.Material3.Chip.Assist">
        <item name="android:clickable">false</item>
        <item name="android:textColor">@color/color_texto_principal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/color_fondo_azul_claro</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="chipMinHeight">32dp</item>
    </style>
</resources>
