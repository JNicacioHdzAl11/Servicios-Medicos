<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/color_fondo"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_borde"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtNombreMedicamentoItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/color_texto_principal"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnEliminarMedicamentoItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Paracetamol 500mg" />

        <TextView
            android:id="@+id/txtPresentacionViaItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/color_texto_secundario"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/btnEliminarMedicamentoItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNombreMedicamentoItem"
            tools:text="Tableta · Vía oral" />

        <ImageButton
            android:id="@+id/btnEliminarMedicamentoItem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar medicamento"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#DC2626" />

        <TextView
            android:id="@+id/txtDosisItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            android:background="@color/color_fondo_secundario"
            android:padding="8dp"
            android:text=""
            android:textColor="@color/color_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/txtFrecuenciaItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtPresentacionViaItem"
            tools:text="Dosis\n1 tableta" />

        <TextView
            android:id="@+id/txtFrecuenciaItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/color_fondo_secundario"
            android:padding="8dp"
            android:text=""
            android:textColor="@color/color_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/txtDosisItem"
            app:layout_constraintEnd_toStartOf="@id/txtDuracionItem"
            app:layout_constraintStart_toEndOf="@id/txtDosisItem"
            tools:text="Frecuencia\nCada 8 h" />

        <TextView
            android:id="@+id/txtDuracionItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@color/color_fondo_secundario"
            android:padding="8dp"
            android:text=""
            android:textColor="@color/color_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/txtDosisItem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/txtFrecuenciaItem"
            tools:text="Duración\n2 días" />

        <TextView
            android:id="@+id/txtNotaMedicamentoItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/color_texto_secundario"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtDosisItem"
            tools:text="Solo en caso de dolor." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>