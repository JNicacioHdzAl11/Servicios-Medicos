<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/txtInicialesAtencion"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_iniciales_circular"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text=""
        android:textColor="@color/color_enlace"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="MG" />

    <TextView
        android:id="@+id/txtNombreAtencion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/color_texto_principal"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/txtDetalleAtencion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtInicialesAtencion"
        app:layout_constraintTop_toTopOf="@id/txtInicialesAtencion"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="María García" />

    <TextView
        android:id="@+id/txtDetalleAtencion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/color_texto_secundario"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/txtInicialesAtencion"
        app:layout_constraintEnd_toEndOf="@id/txtNombreAtencion"
        app:layout_constraintStart_toStartOf="@id/txtNombreAtencion"
        app:layout_constraintTop_toBottomOf="@id/txtNombreAtencion"
        tools:text="Revisión general · 09:10" />

</androidx.constraintlayout.widget.ConstraintLayout>
