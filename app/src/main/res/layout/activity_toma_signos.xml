<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo_secundario"
    tools:context=".vista.TomaSignosActivityJ">

    <!-- Barra superior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clEncabezado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_fondo"
        android:minHeight="64dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comun_cd_regresar"
            android:src="@drawable/ic_flecha_atras"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_texto_principal" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/toma_signos_titulo"
            android:textColor="@color/color_texto_principal"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAjustes"
            app:layout_constraintStart_toEndOf="@id/btnRegresar"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnAjustes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comun_cd_ajustes"
            android:src="@drawable/ic_ajustes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_enlace" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/vDivisorEncabezado"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/color_borde"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clEncabezado" />

    <!-- Contenido -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/vDivisorNavegacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDivisorEncabezado">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Paciente -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaciente"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_fondo_azul_claro"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/color_fondo_azul_claro"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtIniciales"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_iniciales_circular"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text=""
                        android:textColor="@color/color_enlace"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="LF" />

                    <TextView
                        android:id="@+id/txtNombrePaciente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/txtIniciales"
                        app:layout_constraintTop_toTopOf="@id/txtIniciales"
                        tools:text="Luis Fernández" />

                    <TextView
                        android:id="@+id/txtEdadMatricula"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/txtNombrePaciente"
                        app:layout_constraintTop_toBottomOf="@id/txtNombrePaciente"
                        tools:text="20 años · Matrícula 20240128" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/brrPaciente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="txtIniciales,txtEdadMatricula" />

                    <TextView
                        android:id="@+id/txtCarreraGrupo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textColor="@color/color_texto_label"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/brrPaciente"
                        tools:text="Ing. en Sistemas · 5.º cuatrimestre · Grupo A" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Signos vitales -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSignosVitales"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/color_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPaciente"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/glMitad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <ImageView
                        android:id="@+id/imgSignosVitales"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_corazon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/color_enlace" />

                    <TextView
                        android:id="@+id/txtSignosTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/consulta_signos_vitales"
                        android:textColor="@color/color_texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/imgSignosVitales"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgSignosVitales"
                        app:layout_constraintTop_toTopOf="@id/imgSignosVitales" />

                    <TextView
                        android:id="@+id/txtLabelTemperatura"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/etTemperatura"
                        android:text="@string/toma_signos_temperatura"
                        android:textColor="@color/color_texto_label"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/glMitad"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgSignosVitales" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTemperatura"
                        style="@style/SaludCampus.CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/txtLabelTemperatura"
                        app:layout_constraintStart_toStartOf="@id/txtLabelTemperatura"
                        app:layout_constraintTop_toBottomOf="@id/txtLabelTemperatura"
                        app:suffixText="@string/toma_signos_unidad_temperatura"
                        app:suffixTextColor="@color/color_texto_principal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTemperatura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_texto_principal"
                            android:textSize="15sp"
                            tools:text="36.7" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtLabelFrecuenciaCardiaca"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/etFrecuenciaCardiaca"
                        android:text="@string/toma_signos_frecuencia_cardiaca"
                        android:textColor="@color/color_texto_label"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/glMitad"
                        app:layout_constraintTop_toBottomOf="@id/imgSignosVitales" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFrecuenciaCardiaca"
                        style="@style/SaludCampus.CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/txtLabelFrecuenciaCardiaca"
                        app:layout_constraintStart_toStartOf="@id/txtLabelFrecuenciaCardiaca"
                        app:layout_constraintTop_toBottomOf="@id/txtLabelFrecuenciaCardiaca"
                        app:suffixText="@string/toma_signos_unidad_frecuencia_cardiaca"
                        app:suffixTextColor="@color/color_texto_principal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFrecuenciaCardiaca"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_texto_principal"
                            android:textSize="15sp"
                            tools:text="76" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtLabelPresionArterial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/etPresionArterial"
                        android:text="@string/toma_signos_presion_arterial"
                        android:textColor="@color/color_texto_label"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/glMitad"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tilTemperatura" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPresionArterial"
                        style="@style/SaludCampus.CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/txtLabelPresionArterial"
                        app:layout_constraintStart_toStartOf="@id/txtLabelPresionArterial"
                        app:layout_constraintTop_toBottomOf="@id/txtLabelPresionArterial"
                        app:suffixText="@string/toma_signos_unidad_presion_arterial"
                        app:suffixTextColor="@color/color_texto_principal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPresionArterial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_texto_principal"
                            android:textSize="15sp"
                            tools:text="118/78" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtLabelSaturacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/etSaturacion"
                        android:text="@string/toma_signos_saturacion"
                        android:textColor="@color/color_texto_label"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/glMitad"
                        app:layout_constraintTop_toBottomOf="@id/tilTemperatura" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSaturacion"
                        style="@style/SaludCampus.CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/txtLabelSaturacion"
                        app:layout_constraintStart_toStartOf="@id/txtLabelSaturacion"
                        app:layout_constraintTop_toBottomOf="@id/txtLabelSaturacion"
                        app:suffixText="@string/toma_signos_unidad_saturacion"
                        app:suffixTextColor="@color/color_texto_principal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSaturacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_texto_principal"
                            android:textSize="15sp"
                            tools:text="98" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtLabelPeso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/etPeso"
                        android:text="@string/toma_signos_peso"
                        android:textColor="@color/color_texto_label"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/glMitad"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tilPresionArterial" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPeso"
                        style="@style/SaludCampus.CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/txtLabelPeso"
                        app:layout_constraintStart_toStartOf="@id/txtLabelPeso"
                        app:layout_constraintTop_toBottomOf="@id/txtLabelPeso"
                        app:suffixText="@string/toma_signos_unidad_peso"
                        app:suffixTextColor="@color/color_texto_principal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_texto_principal"
                            android:textSize="15sp"
                            tools:text="68.5" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtLabelFrecuenciaRespiratoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/etFrecuenciaRespiratoria"
                        android:text="@string/toma_signos_frecuencia_respiratoria"
                        android:textColor="@color/color_texto_label"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/glMitad"
                        app:layout_constraintTop_toBottomOf="@id/tilPresionArterial" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFrecuenciaRespiratoria"
                        style="@style/SaludCampus.CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@id/txtLabelFrecuenciaRespiratoria"
                        app:layout_constraintStart_toStartOf="@id/txtLabelFrecuenciaRespiratoria"
                        app:layout_constraintTop_toBottomOf="@id/txtLabelFrecuenciaRespiratoria"
                        app:suffixText="@string/toma_signos_unidad_frecuencia_respiratoria"
                        app:suffixTextColor="@color/color_texto_principal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFrecuenciaRespiratoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_texto_principal"
                            android:textSize="15sp"
                            tools:text="16" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtRegistrado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_badge_exito"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text=""
                        android:textColor="@color/color_exito"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tilPeso"
                        tools:text="Registrado · 09:25"
                        tools:visibility="visible" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Observaciones -->
            <TextView
                android:id="@+id/txtLabelObservaciones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etObservaciones"
                android:text="@string/toma_signos_observaciones"
                android:textColor="@color/color_texto_label"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSignosVitales" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilObservaciones"
                style="@style/SaludCampus.CampoTexto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtLabelObservaciones">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="2sp"
                    android:minLines="2"
                    android:text=""
                    android:textColor="@color/color_texto_principal"
                    android:textSize="15sp"
                    tools:text="Paciente consciente y orientado. Refiere cefalea leve desde esta mañana." />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarDoctora"
                style="@style/SaludCampus.BotonPrimario"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/toma_signos_enviar_doctora"
                app:icon="@drawable/ic_chevron_derecha"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilObservaciones" />

            <TextView
                android:id="@+id/txtNota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2sp"
                android:text="@string/toma_signos_nota"
                android:textColor="@color/color_texto_secundario"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnEnviarDoctora" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Navegación inferior de enfermería -->
    <View
        android:id="@+id/vDivisorNavegacion"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/color_borde"
        app:layout_constraintBottom_toTopOf="@id/bnvNavegacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bnvNavegacion"
        style="@style/Widget.Material3.BottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_fondo"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/SaludCampus.IndicadorNavegacion"
        app:itemIconTint="@color/selector_nav_item"
        app:itemTextAppearanceActive="@style/SaludCampus.TextoNavegacion.Activo"
        app:itemTextAppearanceInactive="@style/SaludCampus.TextoNavegacion"
        app:itemTextColor="@color/selector_nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_navegacion_enfermeria" />

</androidx.constraintlayout.widget.ConstraintLayout>
