<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo_secundario"
    tools:context=".vista.ExpedienteMedicoAlumActivityJM">

    <!-- Barra superior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clEncabezado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_fondo"
        android:minHeight="64dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comun_cd_regresar"
            android:src="@drawable/ic_flecha_atras"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_enlace" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Expediente del Alumno"
            android:textColor="@color/color_texto_principal"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivAvatarMedico"
            app:layout_constraintStart_toEndOf="@id/btnRegresar"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatarMedico"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_usuario"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/vDivisorEncabezado"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/color_borde"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clEncabezado" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDivisorEncabezado">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Tarjeta principal del alumno -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaciente"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtIniciales"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@color/color_fondo_azul_claro"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/color_enlace"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="LF" />

                    <TextView
                        android:id="@+id/txtNombrePaciente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/txtIniciales"
                        app:layout_constraintTop_toTopOf="@id/txtIniciales"
                        tools:text="Luis Fernández" />

                    <TextView
                        android:id="@+id/txtMatriculaEdad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/txtNombrePaciente"
                        app:layout_constraintTop_toBottomOf="@id/txtNombrePaciente"
                        tools:text="Matrícula 20240128 · 20 años" />

                    <TextView
                        android:id="@+id/txtCarreraGrupo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text=""
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtIniciales"
                        tools:text="Ing. en Sistemas · 5.º cuatrimestre · Grupo A" />

                    <TextView
                        android:id="@+id/txtAlertaAlergia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#FEE2E2"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text=""
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtCarreraGrupo"
                        tools:text="Alergia: Penicilina" />

                    <TextView
                        android:id="@+id/txtEtiqTipoSangre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="6dp"
                        android:text="Tipo de sangre"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/txtEtiqEnfermedades"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtAlertaAlergia" />

                    <TextView
                        android:id="@+id/txtTipoSangre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/txtEtiqTipoSangre"
                        app:layout_constraintStart_toStartOf="@id/txtEtiqTipoSangre"
                        app:layout_constraintTop_toBottomOf="@id/txtEtiqTipoSangre"
                        tools:text="O positivo (O+)" />

                    <TextView
                        android:id="@+id/txtEtiqEnfermedades"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Enfermedades crónicas"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintBaseline_toBaselineOf="@id/txtEtiqTipoSangre"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/txtEtiqTipoSangre" />

                    <TextView
                        android:id="@+id/txtEnfermedadesCronicas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/txtEtiqEnfermedades"
                        app:layout_constraintStart_toStartOf="@id/txtEtiqEnfermedades"
                        app:layout_constraintTop_toBottomOf="@id/txtEtiqEnfermedades"
                        tools:text="Ninguna referida" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Antecedentes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAntecedentes"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/color_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPaciente"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtTituloAntecedentes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Antecedentes"
                        android:textColor="@color/color_texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/txtEtiqAlergenos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Alérgenos"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTituloAntecedentes" />

                    <TextView
                        android:id="@+id/txtAlergenosDetalle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtEtiqAlergenos"
                        tools:text="Penicilina · reacción cutánea" />

                    <TextView
                        android:id="@+id/txtEtiqCirugias"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Cirugías previas"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtAlergenosDetalle" />

                    <TextView
                        android:id="@+id/txtCirugiasPrevias"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtEtiqCirugias"
                        tools:text="Apendicectomía · 2020" />

                    <TextView
                        android:id="@+id/txtEtiqTratamiento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Tratamiento habitual"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtCirugiasPrevias" />

                    <TextView
                        android:id="@+id/txtTratamientoHabitual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/color_texto_principal"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtEtiqTratamiento"
                        tools:text="Ninguno referido" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Historial de consultas recientes -->
            <TextView
                android:id="@+id/txtSeccionHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Historial de Consultas Recientes"
                android:textColor="@color/color_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAntecedentes" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorialConsultas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSeccionHistorial"
                tools:itemCount="2"
                tools:listitem="@layout/item_consulta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarNuevaConsulta"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color_enlace"
                android:text="Iniciar Nueva Consulta"
                android:textAllCaps="false"
                android:textColor="@color/color_fondo"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvHistorialConsultas" />

            <TextView
                android:id="@+id/txtNotaExpedienteMed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Datos simulados · Expediente confidencial"
                android:textColor="@color/color_texto_secundario"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnIniciarNuevaConsulta" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>