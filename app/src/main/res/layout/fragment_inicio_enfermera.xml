<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo_secundario"
    tools:context=".vista.InicioEnfermera">

    <!-- Barra superior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clEncabezado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_fondo"
        android:minHeight="64dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/inicio_enfermera_titulo"
            android:textColor="@color/color_texto_principal"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnConfiguracion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageButton
            android:id="@+id/btnConfiguracion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comun_cd_ajustes"
            android:src="@drawable/ic_ajustes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_enlace"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contenido desplazable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clEncabezado"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Foto de enfermería -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFotoEnfermera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@color/color_fondo_azul_claro"
                android:contentDescription="@string/comun_cd_foto_personal"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_alumnos"
                app:layout_constraintBottom_toBottomOf="@id/txtFechaActual"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/txtSaludoEnfermera"
                app:shapeAppearanceOverlay="@style/SaludCampus.FormaAvatar"
                tools:src="@drawable/ic_alumnos"/>

            <!-- Saludo -->
            <TextView
                android:id="@+id/txtSaludoEnfermera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/color_texto_principal"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgFotoEnfermera"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Bienvenida"/>

            <TextView
                android:id="@+id/txtCedulaEnfermera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/color_texto_secundario"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/txtSaludoEnfermera"
                app:layout_constraintTop_toBottomOf="@id/txtSaludoEnfermera"
                tools:text="Personal de enfermería"/>

            <TextView
                android:id="@+id/txtFechaActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/color_texto_secundario"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/txtSaludoEnfermera"
                app:layout_constraintTop_toBottomOf="@id/txtCedulaEnfermera"
                tools:text="Viernes, 27 de noviembre"/>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgFotoEnfermera,txtFechaActual"/>

            <!-- Nueva atención -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevaAtencionJ"
                style="@style/SaludCampus.BotonPrimario"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/enfermera_nueva_atencion_j"
                app:icon="@drawable/ic_mas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierSaludo"/>

            <!-- Resumen del día -->
            <TextView
                android:id="@+id/txtResumenDiaJ"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/enfermera_resumen_dia_j"
                android:textColor="@color/color_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnNuevaAtencionJ"/>

            <!-- Tarjeta azul -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCitasHoy"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/color_metrica_azul_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@id/cardAtencionesHoy"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtResumenDiaJ"
                app:strokeColor="@color/color_metrica_azul_borde"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtTotalCitasHoy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/color_metrica_azul"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="1"/>

                    <TextView
                        android:id="@+id/txtEtiquetaCitasHoy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/enfermera_citas_pendientes_hoy_j"
                        android:textColor="@color/color_metrica_azul"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTotalCitasHoy"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta verde -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAtencionesHoy"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/color_metrica_verde_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardCitasHoy"
                app:layout_constraintTop_toTopOf="@id/cardCitasHoy"
                app:strokeColor="@color/color_metrica_verde_borde"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtTotalAtenciones"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/color_metrica_verde"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="0"/>

                    <TextView
                        android:id="@+id/txtEtiquetaAtenciones"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/enfermera_valoraciones_sesion_j"
                        android:maxLines="2"
                        android:textColor="@color/color_metrica_verde"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTotalAtenciones"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Atenciones recientes debajo de las tarjetas -->
            <TextView
                android:id="@+id/txtTituloAtencionesRecientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/inicio_enfermera_atenciones_recientes"
                android:textColor="@color/color_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardCitasHoy"/>

            <!-- Lista de atenciones recientes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAtencionesRecientes"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/color_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloAtencionesRecientes"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/listaAtencionesJ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
